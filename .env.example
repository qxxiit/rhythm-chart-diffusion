# Copy this file to .env and fill in real values
# .env is gitignored and should never be committed

# osu! API credentials
# Get from: https://osu.ppy.sh/home/account/edit -> OAuth -> New OAuth Application
OSU_CLIENT_ID=your_client_id_here
OSU_CLIENT_SECRET=your_client_secret_here

# Weights & Biases
# Get from: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=rhythm-chart-diffusion
WANDB_ENTITY=your_team_name_here

# Optional: HuggingFace (if using pretrained MERT/AST)
# HF_TOKEN=your_hf_token_here

# Paths (override defaults if needed)
# DATA_DIR=/path/to/data
# CHECKPOINT_DIR=/path/to/checkpoints
